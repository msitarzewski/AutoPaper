# Copy to .env for the `autopaper` developer CLI. The apps never read this file: they keep keys in
# the platform's secure store (Keychain, Windows Credential Manager, Secret Service), entered in Settings.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local providers need no key, only an address.
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
COMFYUI_BASE_URL=http://localhost:8188
