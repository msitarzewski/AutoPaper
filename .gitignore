# Secrets — API keys live in .env for the `autopaper` developer CLI, and in each platform's
# secure store (Keychain, Credential Manager, Secret Service) for the apps.
.env
.env.*
!.env.example

# Temporary files for driving the Windows and Linux VMs
.scratch/

# Rust
target/
*.profraw
*.profdata

# Generated UniFFI bindings (rebuilt by scripts/)
apps/macos/Generated/
apps/windows/Generated/

# macOS
.DS_Store

# Xcode — the project is generated from project.yml by XcodeGen, so it is never committed.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserdatad/
DerivedData/
build/
*.xcresult
*.xcframework/

# SwiftPM
.build/
.swiftpm/

# .NET / WinUI
bin/
obj/
*.user
*.suo
.vs/
AppPackages/
*.msix
*.msixbundle
*.appx
*.appxbundle

# Signing material never goes in the repository (certificates, private keys, provisioning profiles)
*.pfx
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# Flatpak
.flatpak-builder/
flatpak-build/
repo/

# Release downloads are built by the release scripts and attached to GitHub Releases, never committed
*.dmg
*.flatpak

# Embedding model weights are downloaded by scripts/fetch-model.sh, not committed. Anchored to the root:
# git on macOS ignores case, so a bare `models/` would also hide apps/windows/AutoPaper/Models/ (source code).
/models/
*.safetensors
*.onnx
*.gguf

# Python caches (site, icon and string tools)
__pycache__/
*.pyc

# Icon previews: regenerated by docs/icon/build_icons.py (the .icon documents and the board are kept)
docs/icon/palettes/previews/

# Website build output (scripts/build_site.py); CI builds and publishes it
_site/
