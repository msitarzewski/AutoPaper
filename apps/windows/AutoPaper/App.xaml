<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AutoPaper.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Windows 11 Settings spacing (SettingsCard guidance): 4 px between cards, a header above each group. -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style>
            <!-- A setting that couldn't be saved, said on its card in place of its description (PaneHeader.ShowProblem). -->
            <Style x:Key="SettingProblemTextBlockStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- Page content column: Settings-style width cap, with the gutter Windows uses. -->
            <x:Double x:Key="PageMaxWidth">1000</x:Double>
            <Thickness x:Key="PagePadding">36,24,36,36</Thickness>
            <Thickness x:Key="PageNarrowPadding">16,16,16,24</Thickness>
            <!-- Settings panes title themselves with a breadcrumb at title size, as Windows 11 Settings does. -->
            <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
            <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
            <x:Double x:Key="BreadcrumbBarChevronFontSize">14</x:Double>
            <Thickness x:Key="BreadcrumbBarChevronPadding">12,6,12,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
