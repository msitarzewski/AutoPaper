<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoPaper.Views.FirstRunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- First run (spec): "Tell your computer what you'd like to see." Three steps, skippable. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="680"
            Padding="36,32,36,48"
            HorizontalAlignment="Center"
            Spacing="28">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="72"
                    Height="72"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/Square44x44Logo.targetsize-96_altform-unplated.png" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Uid="FirstRunTitle" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="FirstRunTagline" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <!-- 1. Keywords. The examples are only shown, never saved. -->
            <StackPanel Spacing="8">
                <TextBlock x:Uid="FirstRunStep1" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="FirstRunStep1Body" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="KeywordBox"
                        x:Uid="FirstRunKeywordBox"
                        AutomationProperties.AutomationId="FirstRunKeyword"
                        KeyDown="OnKeywordKeyDown"
                        MaxLength="40" />
                    <Button x:Uid="KeywordAddButton" Grid.Column="1" VerticalAlignment="Bottom" AutomationProperties.AutomationId="FirstRunAdd" Click="OnAddKeyword" />
                </Grid>
                <TextBlock
                    x:Name="AddedLine"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- 2. Who writes and paints. -->
            <StackPanel Spacing="8">
                <TextBlock x:Uid="FirstRunStep2" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <RadioButtons x:Name="Who" x:Uid="FirstRunWho" AutomationProperties.AutomationId="FirstRunWho" SelectedIndex="3" SelectionChanged="OnWhoChanged">
                    <RadioButton x:Uid="FirstRunOpenAi" />
                    <RadioButton x:Uid="FirstRunGemini" />
                    <RadioButton x:Uid="FirstRunLocal" />
                    <RadioButton x:Uid="FirstRunDemo" />
                </RadioButtons>
            </StackPanel>

            <!-- 3. A key, local servers, or nothing. -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="Step3Title" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="Step3Body" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
                <StackPanel x:Name="KeyStep" Spacing="4" Visibility="Collapsed">
                    <PasswordBox x:Name="KeyBox" Width="360" HorizontalAlignment="Left" AutomationProperties.AutomationId="FirstRunKey" PasswordChanged="OnKeyChanged" />
                    <HyperlinkButton x:Name="GetKeyLink" Padding="0" />
                    <TextBlock
                        x:Name="GeminiNoteLine"
                        x:Uid="GeminiNoteShort"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="LocalStep" Spacing="0" Visibility="Collapsed">
                    <HyperlinkButton x:Uid="FirstRunGetOllama" Padding="0" NavigateUri="https://ollama.com/download/windows" />
                    <HyperlinkButton x:Uid="FirstRunGetComfy" Padding="0" NavigateUri="https://www.comfy.org/download" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="MakeButton"
                    x:Uid="FirstRunMake"
                    AutomationProperties.AutomationId="MakeFirstWallpaper"
                    Click="OnMake"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button x:Uid="FirstRunSkip" AutomationProperties.AutomationId="SkipFirstRun" Click="OnSkip" />
            </StackPanel>
            <!-- Results and problems are also said by the window (AppModel.Announce / AnnounceError). -->
            <TextBlock
                x:Name="Problem"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
