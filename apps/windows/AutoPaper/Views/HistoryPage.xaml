<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoPaper.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AutoPaper.Models">


    <Grid x:Name="Column" Padding="36,24,36,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Column.Padding" Value="16,16,16,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The title and the view: Grid | Gallery (remembered, as on the Mac). -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="HistoryTitle" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource TitleTextBlockStyle}" />
            <SelectorBar
                x:Name="ViewSwitch"
                x:Uid="HistoryView"
                Grid.Column="1"
                AutomationProperties.AutomationId="HistoryView"
                SelectionChanged="OnViewChanged">
                <SelectorBarItem x:Name="GridViewItem" x:Uid="HistoryViewGrid" Tag="Grid">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="GalleryViewItem" x:Uid="HistoryViewGallery" Tag="Gallery">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Grid>

        <!-- Filters: All · Liked · Disliked · Echoes, and a mood (All moods · each mood), apart from each other. When
             both don't fit on one line (a narrow window, larger text), the mood goes on its own line under the filters
             (OnFilterRowSizeChanged), its label still beside its box. -->
        <Grid
            x:Name="FilterRow"
            Grid.Row="1"
            ColumnSpacing="24"
            RowSpacing="8"
            SizeChanged="OnFilterRowSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="Filter" x:Uid="HistoryFilter" SelectionChanged="OnFilterChanged">
                <SelectorBarItem x:Uid="HistoryFilterAll" IsSelected="True" Tag="All" />
                <SelectorBarItem x:Uid="HistoryFilterLiked" Tag="Liked" />
                <SelectorBarItem x:Uid="HistoryFilterDisliked" Tag="Disliked" />
                <SelectorBarItem x:Uid="HistoryFilterEchoes" Tag="Echoes" />
            </SelectorBar>
            <StackPanel
                x:Name="MoodFilterPanel"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="MoodFilterLabel"
                    x:Uid="HistoryMoodFilterLabel"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw" />
                <ComboBox
                    x:Name="MoodFilter"
                    x:Uid="HistoryMoodFilter"
                    MinWidth="180"
                    MaxWidth="280"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="MoodFilter"
                    SelectionChanged="OnMoodFilterChanged" />
            </StackPanel>
        </Grid>

        <!-- Results and empty states; said to screen readers by the window (ShowStatus → AppModel.Announce). A problem
             with something the person can change has its link (docs/app-spec.md 6a). -->
        <StackPanel
            x:Name="StatusLine"
            Grid.Row="2"
            Spacing="2"
            Visibility="Collapsed">
            <TextBlock
                x:Name="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}" />
            <HyperlinkButton
                x:Name="StatusLink"
                Padding="0"
                Click="OnStatusLink"
                Visibility="Collapsed" />
        </StackPanel>

        <GridView
            x:Name="Wallpapers"
            x:Uid="HistoryGrid"
            Grid.Row="3"
            Padding="0,0,0,24"
            AutomationProperties.AutomationId="HistoryGrid"
            ContainerContentChanging="OnContainerContentChanging"
            DoubleTapped="OnItemDoubleTapped"
            IncrementalLoadingTrigger="Edge"
            SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryItem">
                    <!-- GridView sizes every item like the first, so each row's minimum height is set from the text
                         size in use (OnContainerContentChanging, measured by the Metrics text below): titles wrap to
                         two lines (three from 150% text), the date wraps when it needs to, and the badges stack when
                         they don't fit side by side. The full title is the item's tooltip (shown on keyboard focus too)
                         and part of its spoken name. -->
                    <Grid Width="248" Padding="4,4,4,10" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Height="135"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Image AutomationProperties.AccessibilityView="Raw" Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <Grid Grid.Row="1" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ItemTitle"
                                VerticalAlignment="Top"
                                MaxLines="2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords" />
                            <Button
                                Grid.Column="1"
                                Padding="6,4"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Bind MoreName, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnMoreActions"
                                ToolTipService.ToolTip="{x:Bind MoreName, Mode=OneWay}">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Grid.Row="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind When, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <!-- Badges: an icon and a word each, never colour alone. -->
                        <StackPanel x:Name="Badges" Grid.Row="3" Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind LikedBadge, Mode=OneWay}">
                                <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE8E1;" />
                                <TextBlock x:Uid="BadgeLiked" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind DislikedBadge, Mode=OneWay}">
                                <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE8E0;" />
                                <TextBlock x:Uid="BadgeDisliked" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind EchoBadge, Mode=OneWay}">
                                <FontIcon VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" FontSize="12" Glyph="&#xE8EE;" />
                                <TextBlock x:Uid="BadgeEcho" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Gallery (like File Explorer's preview, or Finder's Gallery on the Mac): the selected wallpaper large, a
             filmstrip under it (arrow keys move along it; Enter or double-click shows one on the desktop; History's
             menu on each), and its details beside it with Show on desktop as the primary action. -->
        <Grid
            x:Name="GalleryView"
            Grid.Row="3"
            Padding="0,0,0,16"
            ColumnSpacing="24"
            RowSpacing="12"
            SizeChanged="OnGallerySizeChanged"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GalleryPictureColumn" Width="*" />
                <ColumnDefinition x:Name="GalleryDetailsColumn" Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="GalleryFrame"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Image x:Name="GalleryPicture" AutomationProperties.AutomationId="GalleryPicture" Stretch="Uniform" />
            </Border>
            <ListView
                x:Name="Filmstrip"
                x:Uid="HistoryFilmstrip"
                Grid.Row="1"
                Height="104"
                AutomationProperties.AutomationId="Filmstrip"
                ContainerContentChanging="OnContainerContentChanging"
                DoubleTapped="OnItemDoubleTapped"
                IncrementalLoadingTrigger="Edge"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.IsHorizontalRailEnabled="True"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectionChanged="OnFilmstripSelectionChanged"
                SelectionMode="Single">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryItem">
                        <Border
                            Width="136"
                            Height="76"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Image AutomationProperties.AccessibilityView="Raw" Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer
                x:Name="GalleryDetailsPane"
                Grid.RowSpan="2"
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="GalleryDetails" Padding="0,0,8,8" Spacing="10">
                    <TextBlock
                        x:Name="GalleryTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="GallerySummary" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" />
                    <StackPanel x:Name="GalleryEcho" Spacing="2" Visibility="Collapsed">
                        <TextBlock
                            x:Name="GalleryEchoNote"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource BodyTextBlockStyle}" />
                        <HyperlinkButton
                            x:Name="GalleryLineage"
                            x:Uid="GalleryLineage"
                            Padding="0"
                            Click="OnGalleryLineage" />
                    </StackPanel>
                    <TextBlock x:Name="GalleryFacts" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="GalleryProvenance"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <Expander x:Uid="GalleryPrompt" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock
                            x:Name="GalleryImagePrompt"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </Expander>
                    <HyperlinkButton x:Uid="GalleryOpenConsole" Padding="0" Click="OnGalleryOpenConsole" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Name="GalleryLike" x:Uid="NowLike" AutomationProperties.AutomationId="GalleryLike" Click="OnGalleryLike">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE8E1;" />
                                <TextBlock x:Uid="NowLikeText" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="GalleryDislike" x:Uid="NowDislike" AutomationProperties.AutomationId="GalleryDislike" Click="OnGalleryDislike">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE8E0;" />
                                <TextBlock x:Uid="NowDislikeText" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Button
                            x:Name="GalleryShow"
                            x:Uid="GalleryShowOnDesktop"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="GalleryShowOnDesktop"
                            Click="OnGalleryShow"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="GalleryEchoButton" x:Uid="GalleryMakeEcho" HorizontalAlignment="Left" Click="OnGalleryEcho" />
                        <Button x:Name="GalleryReveal" x:Uid="GalleryShowInExplorer" HorizontalAlignment="Left" Click="OnGalleryReveal" />
                        <Button x:Name="GalleryDelete" x:Uid="GalleryDelete" HorizontalAlignment="Left" Click="OnGalleryDelete" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Text measured at the size in use (Windows' text size setting), for the items' row heights. Invisible and
             not in the UI Automation tree. -->
        <Canvas
            Grid.Row="3"
            IsHitTestVisible="False"
            Opacity="0">
            <TextBlock x:Name="MeasureTitle" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
            <TextBlock x:Name="MeasureCaption" AutomationProperties.AccessibilityView="Raw" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords" />
        </Canvas>
    </Grid>
</Page>
