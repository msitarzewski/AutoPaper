<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoPaper.Views.Panes.BudgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="{StaticResource SettingsCardSpacing}">
            <BreadcrumbBar x:Name="Crumbs" Margin="0,0,0,20" AutomationProperties.HeadingLevel="Level1" />

            <toolkit:SettingsCard x:Name="BudgetCard" x:Uid="BudgetMonthly">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EF;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BudgetBox" x:Uid="BudgetBox" MinWidth="160" AutomationProperties.AutomationId="Budget" SelectionChanged="OnBudgetChanged" />
            </toolkit:SettingsCard>
            <!-- Custom: the amount, after the picker that reveals it (the next Tab stop), with its unit in words. -->
            <toolkit:SettingsCard x:Name="CustomBudgetCard" x:Uid="BudgetCustomCard" Visibility="Collapsed">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C7;" />
                </toolkit:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="CustomBudget"
                    x:Uid="BudgetCustomBox"
                    Width="160"
                    AutomationProperties.AutomationId="CustomBudget"
                    LargeChange="10"
                    Maximum="1000"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnCustomBudgetChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="SpentCard" x:Uid="BudgetSpent">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE787;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard x:Name="EstimateCard" x:Uid="BudgetEstimate">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D9;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
            <TextBlock
                x:Name="PricesLine"
                Margin="0,12,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
